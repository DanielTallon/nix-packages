diff --git a/services/WallpaperEngine.qml b/services/WallpaperEngine.qml
index 355bcc4..1b19d20 100644
--- a/services/WallpaperEngine.qml
+++ b/services/WallpaperEngine.qml
@@ -29,6 +29,17 @@ Singleton {
     // The wallpaper command ("" when Quickshell draws the wallpaper).
     readonly property string command: SettingsConfig.wallpaperCommand.trim()
     readonly property bool external: command !== ""
+    // Plasma draws the wallpaper (plasma-apply-wallpaperimage), so its
+    // transitions are played over Plasma's desktop instead: WallpaperLayer
+    // keeps a see-through window there that shows only while a picture
+    // changes, and Plasma's own wallpaper is changed under it.
+    readonly property bool plasmaCommand: /^plasma-apply-wallpaperimage(\s|$)/.test(command)
+    readonly property bool overlay: external && plasmaCommand
+    // The fill mode as Plasma names it, passed along unless the command
+    // names one itself.
+    readonly property string plasmaFill: ({ crop: "preserveAspectCrop", fit: "preserveAspectFit", stretch: "stretch", center: "pad", tile: "tile" })[fill]
+    // A picture whose command waits for its transition to cover the screen.
+    property string coverPending: ""
     // Why the last run of the command failed ("" when it didn't).
     property string commandError: ""
 
@@ -112,11 +123,40 @@ Singleton {
         current = p;
         serial++;
         changed(p);
-        if (external)
+        // Over Plasma, a picture is handed to Plasma once its transition
+        // covers the screen (WallpaperLayer calls covered()), or in a moment
+        // if none starts.
+        if (overlay && kind(p) === "image") {
+            coverPending = p;
+            coverTimer.restart();
+        } else if (external) {
+            coverPending = "";
             runCommand(p);
+        }
         apply.exec([Quickshell.shellPath("scripts/wallpaper-apply"), p]);
     }
 
+    // A transition over Plasma's desktop now hides it: Plasma can change.
+    function covered() {
+        coverTimer.stop();
+        if (coverPending === "")
+            return;
+        runCommand(coverPending);
+        coverPending = "";
+    }
+
+    Timer {
+        id: coverTimer
+        interval: 1500
+        onTriggered: root.covered()
+    }
+
+    // Plasma's fill mode follows the picker's setting.
+    onPlasmaFillChanged: {
+        if (overlay && ready && kind(current) === "image")
+            runCommand(current);
+    }
+
     // The command as a script taking the file as $1: each `{}` becomes it,
     // quoted for wherever the `{}` stands (bare, in "…" or in '…'), and with
     // no `{}` the file goes last.
@@ -152,7 +192,9 @@ Singleton {
     function runCommand(path) {
         if (!external || !path)
             return;
-        const cmd = fileInCommand(command);
+        let cmd = fileInCommand(command);
+        if (plasmaCommand && !/\s(-f|--fill-mode)(\s|=)/.test(command))
+            cmd = cmd.replace(/^plasma-apply-wallpaperimage/, "plasma-apply-wallpaperimage --fill-mode " + plasmaFill);
         // Prints "<exit code>\t<last line of its errors>" when it's done.
         const script = 'err=$(mktemp)\n'
             + '{ ' + cmd + '\n} </dev/null >/dev/null 2>"$err" &\n'
