+    // The wallpaper transitions (WallpaperEngine.transitions, then random).
+    readonly property var transitionOptions: [
+        { key: "grow", label: "Grow", note: "A soft circle grows from the middle." },
+        { key: "tiles", label: "Tiles", note: "Square tiles flip over in a diagonal wave." },
+        { key: "scan", label: "Scan", note: "A bright scanline wipes down the screen." },
+        { key: "warp", label: "Warp", note: "An iris opens with a glowing rim as the picture settles from a slight zoom." },
+        { key: "fade", label: "Fade", note: "A slow crossfade." },
+        { key: "ink", label: "Ink", note: "The new picture bleeds in along inky edges." },
+        { key: "glitch", label: "Glitch", note: "Blocks cut in at random, torn sideways and split red and blue." },
+        { key: "fusuma", label: "Sliding door", note: "The old picture slides away like a painted sliding door." },
+        { key: "fan", label: "Fan", note: "The new picture fans open ray by ray from the bottom, gold along the rays." },
+        { key: "glass", label: "Stained glass", note: "Leaded panes turn over one at a time, flashing colored light." },
+        { key: "press", label: "Press", note: "Six newspaper columns are printed in growing halftone dots." },
+        { key: "dust", label: "Dust storm", note: "A dust storm blows through from the left." },
+        { key: "rule", label: "Astrolabe", note: "A rule sweeps round from twelve o'clock, degrees marked as it turns." },
+        { key: "tide", label: "Tide", note: "The new picture rises under a rippling waterline, bubbles and all." },
+        { key: "lotus", label: "Lotus", note: "A lotus opens from the middle, its petals edged in gold." },
+        { key: "fire", label: "Fire", note: "The old picture burns away from the bottom up, embers and sparks." },
+        { key: "random", label: "Random", note: "A different one every time." }
+    ]
+    readonly property int transitionIndex: Math.max(0, transitionOptions.findIndex(t => t.key === SettingsConfig.wallpaperTransition))
+
+    function stepTransition(d) {
+        const n = transitionOptions.length;
+        SettingsConfig.wallpaperTransition = transitionOptions[(transitionIndex + d + n) % n].key;
+    }
+
     signal closeRequested
 
     // "", "checking", "missing", "relative", "failed" or "saved"
@@ -173,6 +200,28 @@ Rectangle {
         color: card.muted
     }
 
