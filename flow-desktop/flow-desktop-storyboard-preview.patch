diff --git a/src/lib/storyboard.test.ts b/src/lib/storyboard.test.ts
new file mode 100644
index 0000000..6cd1d4d
--- /dev/null
+++ b/src/lib/storyboard.test.ts
@@ -0,0 +1,60 @@
+import { describe, expect, it } from "vitest";
+import { parseStoryboardSpec, storyboardFrameAt } from "./storyboard";
+
+const SPEC =
+  "https://i.ytimg.com/sb/abcdefghijk/storyboard3_L$L/$N.jpg?sqp=xyz" +
+  "|48#27#100#10#10#0#default#rs$AAA" +
+  "|80#45#108#10#10#2000#M$M#rs$BBB" +
+  "|160#90#108#5#5#2000#M$M#rs$CCC";
+
+describe("parseStoryboardSpec", () => {
+  it("keeps the sharpest level", () => {
+    const storyboard = parseStoryboardSpec(SPEC);
+    expect(storyboard?.level).toMatchObject({
+      level: 2,
+      width: 160,
+      height: 90,
+      columns: 5,
+      rows: 5,
+      intervalMs: 2000,
+      sigh: "rs$CCC",
+    });
+  });
+
+  it("rejects missing or malformed specs", () => {
+    expect(parseStoryboardSpec(null)).toBeNull();
+    expect(parseStoryboardSpec("")).toBeNull();
+    expect(parseStoryboardSpec("not a url|1#2")).toBeNull();
+  });
+});
+
+describe("storyboardFrameAt", () => {
+  const storyboard = parseStoryboardSpec(SPEC)!;
+
+  it("finds the sheet and cell for a time", () => {
+    // 61s / 2s = frame 30 → sheet 1 (25 per sheet), cell 5 → column 0, row 1.
+    const frame = storyboardFrameAt(storyboard, 61, 216);
+    expect(frame).toEqual({
+      url: "https://i.ytimg.com/sb/abcdefghijk/storyboard3_L2/M1.jpg?sqp=xyz&sigh=rs%24CCC",
+      width: 160,
+      height: 90,
+      x: 0,
+      y: 90,
+    });
+  });
+
+  it("clamps to the last frame", () => {
+    const frame = storyboardFrameAt(storyboard, 10_000, 216);
+    // Frame 107 → sheet 4, cell 7 → column 2, row 1.
+    expect(frame).toMatchObject({ x: 320, y: 90 });
+    expect(frame?.url).toContain("/M4.jpg");
+  });
+
+  it("spreads frames over the duration when no interval is given", () => {
+    const single = parseStoryboardSpec(
+      "https://i.ytimg.com/sb/abcdefghijk/storyboard3_L$L/$N.jpg?sqp=xyz|48#27#100#10#10#0#M$M#rs$AAA",
+    )!;
+    // 100 frames over 200s → 2s each; 50s → frame 25 → column 5, row 2.
+    expect(storyboardFrameAt(single, 50, 200)).toMatchObject({ x: 240, y: 54 });
+  });
+});
diff --git a/src/lib/storyboard.ts b/src/lib/storyboard.ts
new file mode 100644
index 0000000..4dae427
--- /dev/null
+++ b/src/lib/storyboard.ts
@@ -0,0 +1,106 @@
+/**
+ * Seekbar hover thumbnails from YouTube's storyboard sprite sheets.
+ *
+ * The player response carries `storyboards.playerStoryboardSpecRenderer.spec`:
+ * a `|`-separated string whose first field is a URL template and each further
+ * field one level, `width#height#count#columns#rows#intervalMs#name#sigh`.
+ * Level `n` is addressed as `$L` = n; `$N` is the level's name, in which `$M`
+ * is the sprite sheet index.
+ */
+
+export type StoryboardLevel = {
+  level: number;
+  width: number;
+  height: number;
+  count: number;
+  columns: number;
+  rows: number;
+  intervalMs: number;
+  name: string;
+  sigh: string;
+};
+
+export type Storyboard = {
+  baseUrl: string;
+  level: StoryboardLevel;
+};
+
+export type StoryboardFrame = {
+  url: string;
+  width: number;
+  height: number;
+  /** Offset of the frame inside its sprite sheet, in pixels. */
+  x: number;
+  y: number;
+};
+
+/** Parse a spec and keep its sharpest level. Returns null when unusable. */
+export function parseStoryboardSpec(spec: string | null | undefined): Storyboard | null {
+  if (!spec) return null;
+  const [baseUrl, ...rawLevels] = spec.split("|");
+  if (!baseUrl?.startsWith("https://")) return null;
+
+  let best: StoryboardLevel | null = null;
+  for (const [level, raw] of rawLevels.entries()) {
+    const fields = raw.split("#");
+    if (fields.length < 8) continue;
+    const [width = 0, height = 0, count = 0, columns = 0, rows = 0, intervalMs = 0] = fields
+      .slice(0, 6)
+      .map(Number);
+    const name = fields[6] ?? "";
+    const sigh = fields.slice(7).join("#");
+    if (![width, height, count, columns, rows].every((n) => Number.isFinite(n) && n > 0)) continue;
+    // Sheets without a `$M` page slot are single-image previews too coarse to scrub with.
+    if (!name.includes("$M") && rawLevels.length > 1) continue;
+    if (!best || width * height > best.width * best.height) {
+      best = {
+        level,
+        width,
+        height,
+        count,
+        columns,
+        rows,
+        intervalMs: Number.isFinite(intervalMs) ? intervalMs : 0,
+        name,
+        sigh,
+      };
+    }
+  }
+
+  return best ? { baseUrl, level: best } : null;
+}
+
+/** The sprite sheet and offset showing `timeSeconds` of a `durationSeconds` video. */
+export function storyboardFrameAt(
+  storyboard: Storyboard,
+  timeSeconds: number,
+  durationSeconds: number,
+): StoryboardFrame | null {
+  const { level } = storyboard;
+  const intervalMs =
+    level.intervalMs > 0 ? level.intervalMs : (durationSeconds * 1000) / level.count;
+  if (!(intervalMs > 0)) return null;
+
+  const index = Math.min(
+    level.count - 1,
+    Math.max(0, Math.floor((timeSeconds * 1000) / intervalMs)),
+  );
+  const perSheet = level.columns * level.rows;
+  const sheet = Math.floor(index / perSheet);
+  const cell = index % perSheet;
+
+  const url = new URL(
+    storyboard.baseUrl
+      .replace("$L", String(level.level))
+      .replace("$N", level.name.replace("$M", String(sheet))),
+  );
+  if (level.sigh) url.searchParams.set("sigh", level.sigh);
+
+  return {
+    url: url.toString(),
+    width: level.width,
+    height: level.height,
+    x: (cell % level.columns) * level.width,
+    y: Math.floor(cell / level.columns) * level.height,
+  };
+}
