     // What a file is drawn as: "video", "animated" (GIF/WebP, which may
     // still be one frame) or "image".
     function kind(path) {
@@ -87,6 +95,9 @@ Singleton {
         const p = resolve(path);
         if (!p)
             return;
+        // A new one each time, never the last one again.
+        if (SettingsConfig.wallpaperTransition === "random")
+            pickedTransition = (pickedTransition + 1 + Math.floor(Math.random() * (transitions.length - 1))) % transitions.length;
         current = p;
         serial++;
