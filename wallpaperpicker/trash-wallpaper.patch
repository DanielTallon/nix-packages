+    // First press arms it, the second (same card) sends it to the trash.
+    // The wallpaper on the desktop stays: its file is still in use.
+    function requestDelete() {
+        const e = currentEntry;
+        if (!e || e.item || online || choosing || closing)
+            return;
+        if (isActive(e)) {
+            deleteArmed = "";
+            deleteNote = "It's on your desktop: set another wallpaper first";
+            deleteNoteTimer.restart();
+            return;
+        }
+        if (deleteArmed !== e.fileName) {
+            deleteArmed = e.fileName;
+            deleteNote = "";
+            return;
+        }
+        deleteArmed = "";
+        trashRun.name = e.fileName;
+        // Prints "ok", or gio's last line of errors.
+        trashRun.exec(["sh", "-c", 'out=$(gio trash -- "$1" 2>&1) && echo ok || printf "%s" "$out" | tail -n 1',
+            "sh", WallpaperEngine.dir + "/" + e.fileName]);
+    }
