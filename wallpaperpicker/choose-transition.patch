--- a/services/WallpaperEngine.qml
+++ b/services/WallpaperEngine.qml
@@ -51,6 +51,14 @@ Singleton {
 
     signal changed(string path)
 
+    // The transitions WallpaperLayer can play (shaders/wallpaper_transition.frag,
+    // in its order), the one set in the picker's settings, and with "random"
+    // the one picked for this change: every screen plays the same one.
+    readonly property var transitions: ["grow", "tiles", "scan", "warp", "fade", "ink", "glitch", "fusuma", "fan", "glass", "press", "dust", "rule", "tide", "lotus", "fire"]
+    property int pickedTransition: 0
+    readonly property int transitionMode: SettingsConfig.wallpaperTransition === "random" ? pickedTransition
+        : Math.max(0, transitions.indexOf(SettingsConfig.wallpaperTransition))
