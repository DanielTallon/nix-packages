+                icon: "chevron_right"
+                onClicked: card.stepTransition(1)
+            }
+        }
+
+        Note {
+            text: WallpaperEngine.external ? "Another program draws the wallpaper here (the wallpaper command), so these don't play."
+                : card.transitionOptions[card.transitionIndex].note
+        }
     }
 }
