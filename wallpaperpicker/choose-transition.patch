+
     component Field: StyledTextField {
         width: parent.width
         height: 40 * card.u
@@ -514,5 +563,58 @@ Rectangle {
             text: previewRow.checked ? "Your desktop stays behind the deck; hold or tap Space to see the card in front full screen."
                 : "The card in front is shown full screen behind the deck as you browse."
         }
+
+        Item {
+            width: 1
+            height: 8 * card.u
+        }
+
+        Label {
+            text: "TRANSITION"
+        }
+
+        // ‹ name › : the arrows step through the transitions.
+        Item {
+            width: parent.width
+            height: 40 * card.u
+
+            Arrow {
+                id: transPrev
+                anchors.left: parent.left
+                icon: "chevron_left"
+                onClicked: card.stepTransition(-1)
+            }
+
+            Rectangle {
+                anchors.left: transPrev.right
+                anchors.right: transNext.left
